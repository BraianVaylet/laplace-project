# =============================================================================
# Laplace — variables de entorno
# Copiar a .env y completar. NUNCA commitear .env.
# En staging y prod las variables viven en Railway, no en un archivo.
# =============================================================================

# --- Entorno --------------------------------------------------------------
NODE_ENV=development                      # development | test | production
APP_ENV=dev                               # dev | staging | prod (etiqueta de logs)
LOG_LEVEL=debug                           # trace | debug | info | warn | error

# --- API ------------------------------------------------------------------
API_PORT=3000
API_BASE_URL=http://localhost:3000
# Origenes permitidos por CORS, separados por coma. Sin comodines en prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Rate limit de login, registro y recupero (spec §9.1). Se puede poner en `off`
# SOLO con APP_ENV=dev: el arranque lo rechaza en staging y en prod.
AUTH_RATE_LIMIT=on

# --- MongoDB Atlas --------------------------------------------------------
# Requiere replica set: las transacciones de reserva + descuento de credito
# no funcionan sin el (ver docs/adr/003-monorepo.md).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/laplace_dev?retryWrites=true&w=majority
MONGODB_DB_NAME=laplace_dev

# --- Better Auth ----------------------------------------------------------
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=<generar-32-bytes-base64>
BETTER_AUTH_URL=http://localhost:3000

# --- Backblaze B2 (buckets privados + URLs firmadas) ----------------------
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=laplace-dev
B2_KEY_ID=<application-key-id>
B2_APP_KEY=<application-key>
B2_SIGNED_URL_TTL_SECONDS=300

# --- Mercado Pago (Fase 2) ------------------------------------------------
# Cada centro conecta SU cuenta via OAuth. Estas credenciales son las de la
# aplicacion de Laplace, no las de un centro (ver docs/adr/002-payments.md).
MP_CLIENT_ID=<app-client-id>
MP_CLIENT_SECRET=<app-client-secret>
MP_ACCESS_TOKEN=<access-token-de-test>
MP_WEBHOOK_SECRET=<secret-para-validar-la-firma>
MP_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/billing/mp/callback

# --- Email transaccional --------------------------------------------------
RESEND_API_KEY=<api-key>
EMAIL_FROM=Laplace <no-reply@example.com>

# --- Web Push (VAPID) -----------------------------------------------------
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<public-key>
VAPID_PRIVATE_KEY=<private-key>
VAPID_SUBJECT=mailto:soporte@example.com

# --- Observabilidad -------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# --- Jobs y colas ---------------------------------------------------------
REDIS_URL=redis://localhost:6379
JOBS_ENABLED=true

# --- Frontends (Vite: solo lo prefijado con VITE_ llega al browser) -------
# Nunca poner un secreto aca. Todo VITE_* es publico.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_ENV=dev
VITE_SENTRY_DSN=
VITE_VAPID_PUBLIC_KEY=<public-key>
